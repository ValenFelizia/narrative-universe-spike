{
  "name": "narrative-universe-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless CodeMirror 6 to Rust edit adapter and save-session contract for PA-I3 A1.",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/adapter.test.ts test/save-session.test.ts test/desktop.test.ts",
    "desktop:check": "tsc --noEmit -p desktop/tsconfig.json",
    "desktop:frontend:dev": "vite --config desktop/vite.config.ts",
    "desktop:frontend:build": "vite build --config desktop/vite.config.ts",
    "desktop:dev": "tauri dev --config src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config src-tauri/tauri.conf.json"
  },
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
