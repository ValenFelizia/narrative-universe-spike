{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Narrative Universe",
  "version": "0.1.0",
  "identifier": "org.narrativeuniverse.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run desktop:frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Narrative Universe",
        "width": 1120,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
